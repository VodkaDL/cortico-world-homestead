{
  "name": "cortico-world-homestead",
  "version": "1.0.2",
  "type": "module",
  "keywords": [
    "cortico",
    "cortico-world",
    "game",
    "companion"
  ],
  "description": "田园烟火，我要给她完整的鱼生！\n\n🌱 作物种植：播种、浇水、收获，体验农耕乐趣。\n🐄 动物养殖：饲养动物，获取各类农产品。\n🍳 烹饪料理：使用食材制作丰富美食。\n🏡 家园经营：管理物资，打造温馨家园。\n🛒 自由交易：买卖商品，积累财富。\n🎒 物品储存：管理背包与仓库资源。\n💚 角色护理：关注角色状态与日常需求。",
  "license": "MIT",
  "author": "VodkaDL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VodkaDL/cortico-world-homestead.git"
  },
  "homepage": "https://github.com/VodkaDL/cortico-world-homestead#readme",
  "engines": {
    "node": ">=18.17"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "tools",
    "test",
    "preview",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check.mjs",
    "describe": "node tools/describe.mjs",
    "catalog": "node tools/catalog.mjs",
    "install:local": "node tools/install.mjs",
    "preview": "node tools/preview.mjs",
    "drymount": "node tools/drymount.mjs",
    "prepack": "node tools/describe.mjs && node tools/check.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "田园烟火",
    "icon": "assets/icon.png",
    "screenshots": [
      "assets/screenshots/1.png",
      "assets/screenshots/2.png",
      "assets/screenshots/3.png",
      "assets/screenshots/4.png",
      "assets/screenshots/5.png",
      "assets/screenshots/6.png",
      "assets/screenshots/7.png",
      "assets/screenshots/8.png"
    ],
    "tags": [
      "game",
      "companion"
    ],
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  }
}
